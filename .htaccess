<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloqueia acesso direto ao código e aos arquivos de configuração.
    RewriteRule ^(?:app|bootstrap|config|database|deploy|resources|routes|storage|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env|artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|vite\.config\.js)$ - [F,L,NC]

    # A hospedagem Web/Cloud da Hostinger fixa public_html como raiz.
    # Encaminha as requisições para o front controller seguro do Laravel.
    RewriteCond %{REQUEST_URI} !^/public/ [NC]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_headers.c>
    # Mantém a política definida pela aplicação mesmo quando a hospedagem
    # acrescenta apenas a diretiva upgrade-insecure-requests.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; upgrade-insecure-requests"
    Header always unset X-Powered-By
</IfModule>
